{
  "name": "one-more",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:lan": "HOST=0.0.0.0 node --import tsx server/index.ts",
    "check:worker": "tsc -p tsconfig.worker.json --noEmit",
    "deploy:cloudflare": "npm run build && npm run check:worker && wrangler deploy",
    "dev:cloudflare": "npm run build && wrangler dev --port 4320"
  },
  "dependencies": {
    "@elevenlabs/react": "1.15.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.131.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
